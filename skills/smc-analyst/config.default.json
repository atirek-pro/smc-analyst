{
  "_meta": {
    "schema_version": 1,
    "note": "Default settings for smc-analyst. Do not edit this file; create config.json next to it with only the keys you want to override."
  },
  "timeframes": {
    "ladder": ["1W", "1D", "4H", "1H", "15m", "5m", "1m"],
    "include_monthly": false,
    "history_bars": 500
  },
  "swings": {
    "lookback": { "1M": 2, "1W": 3, "1D": 3, "4H": 4, "1H": 5, "15m": 5, "5m": 5, "1m": 5 },
    "internal_lookback": 2
  },
  "atr": {
    "period": 14
  },
  "structure": {
    "break_confirmation": "body_close",
    "confirmation_timeframe": "15m",
    "entry_timeframe": "5m"
  },
  "liquidity": {
    "equal_level_tolerance_atr": 0.1,
    "sweep_requires_close_back_inside": true
  },
  "zones": {
    "displacement_body_atr": 1.2,
    "ob_requires_displacement_or_fvg": true,
    "fvg_min_size_atr": 0.1,
    "ob_search_back_bars": 3,
    "base_max_body_atr": 0.5,
    "base_max_candles": 3,
    "max_zones_per_timeframe": 6
  },
  "pd_array": {
    "equilibrium": 0.5,
    "equilibrium_band": 0.05,
    "ote": [0.62, 0.79]
  },
  "sessions": {
    "timezone": "America/New_York",
    "killzones": {
      "asia": ["20:00", "00:00"],
      "london": ["02:00", "05:00"],
      "new_york": ["07:00", "10:00"]
    }
  },
  "trade": {
    "entry_mode": "ob_edge",
    "sl_atr_buffer": 0.25,
    "min_rr": 2.0,
    "targets": ["internal_liquidity", "next_swing", "htf_draw_on_liquidity"]
  },
  "risk": {
    "account_size": null,
    "risk_pct": 1.0,
    "account_currency": "USD"
  },
  "hedge": {
    "correlation_window_days": 30,
    "min_abs_correlation": 0.5,
    "history_days": 120
  },
  "tracker": {
    "signal_expiry_hours": 48,
    "timeframe": "5m",
    "journal_path": "journal.json",
    "max_catchup_bars": 5000
  },
  "data": {
    "cache_dir": "cache",
    "cache_ttl_seconds": null,
    "poll_interval_seconds": 30
  },
  "server": {
    "host": "127.0.0.1",
    "port_range": [8765, 8799],
    "open_browser": true
  }
}
